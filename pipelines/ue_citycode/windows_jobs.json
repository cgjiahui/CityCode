{
  "schema": "citycode.ue_windows_job_examples.v1",
  "execution_status": "templates_only_not_executed",
  "path_instructions": "When adapting an example job, replace {WORK_ROOT} with the absolute writable job directory and {CITY_SAMPLE_PROJECT} with the full path to your CitySample.uproject. Use forward slashes or JSON-escaped backslashes in paths.",
  "work_root": "{WORK_ROOT}",
  "project": "{CITY_SAMPLE_PROJECT}",
  "required_plugins": ["PythonScriptPlugin", "EditorScriptingUtilities", "GLTFImporter"],
  "preflight": {
    "action": "preflight",
    "output_json": "{WORK_ROOT}\\preflight_result.json"
  },
  "export_catalog": {
    "action": "export_catalog",
    "max_assets": 3000,
    "mesh_paths": [],
    "output_json": "{WORK_ROOT}\\asset_catalog.json"
  },
  "import_bridge_template": {
    "action": "import_bridge_template",
    "template_manifest": "{WORK_ROOT}\\bridge_assets\\spans\\span_manifest.json",
    "output_json": "{WORK_ROOT}\\native_bridge_catalog.json",
    "output_proposal": "{WORK_ROOT}\\native_bridge_spans_proposal.json"
  },
  "assemble": {
    "action": "assemble",
    "assembly_manifest": "{WORK_ROOT}\\prepared\\assembly_manifest.json",
    "output_json": "{WORK_ROOT}\\assemble_result.json",
    "add_inspection_lighting": true
  },
  "import_available": {
    "action": "import_available",
    "assembly_manifest": "{WORK_ROOT}\\prepared\\frozen_geometry_manifest.json",
    "output_json": "{WORK_ROOT}\\import_checkpoint.json",
    "include_kinds": ["building", "massing", "surface"],
    "worker_count": 1,
    "worker_index": 0,
    "wait_for_complete": true,
    "poll_seconds": 5,
    "require_distance_fields_disabled": true,
    "stop_file": "{WORK_ROOT}\\import.stop"
  },
  "readback": {
    "action": "readback",
    "assembly_manifest": "{WORK_ROOT}\\prepared\\assembly_manifest.json",
    "assembly_result": "{WORK_ROOT}\\assemble_result.json",
    "output_json": "{WORK_ROOT}\\readback_result.json",
    "bounds_tolerance_m": 0.025
  },
  "bridge_asset_binding_format": {
    "bridge_deck_default": {
      "mesh_path": null,
      "orientation_confirmed": false,
      "deck_top_local_z_cm": null,
      "local_axes": {"length_axis": null, "up_axis": "Z"},
      "maximum_width_scale": 1.5,
      "maximum_length_scale": 2.0,
      "comment": "Confirm actual local driving-surface Z (rail tops are different), orientation, and mesh identity; never use placed bridge Actor transforms"
    }
  }
}
